&GLOBAL
  PROJECT LiPSCl_surf_v3
  RUN_TYPE GEO_OPT
  PRINT_LEVEL LOW
  SEED 20260330
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS

    &MGRID
      CUTOFF 350
      REL_CUTOFF 50
      NGRIDS 5
      EMAX_SPLINE 1.0  # 依然建议保留，增强数值稳定性
    &END MGRID

    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
      EXTRAPOLATION ASPC
    &END QS

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-06
      MAX_SCF 300
      ADDED_MOS 200
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 1578
      &END SMEAR
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.1
        NBROYDEN 8
      &END MIXING
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &POISSON
      PERIODIC XY
      POISSON_SOLVER ANALYTIC
    &END POISSON
  &END DFT

  &SUBSYS
    &CELL
      A 14.537405 0.000000 0.000000
      B  0.000000 20.558996 0.000000
      C  0.000000 0.000000 43.612217
      PERIODIC XY
    &END CELL

    &COORD
      SCALED T
      # --- Cl (24) ---
      Cl 0.163897227 0.979654449 0.379202191
      Cl 0.094565763 0.476568354 0.381114863
      Cl 0.656602890 0.974981743 0.380661372
