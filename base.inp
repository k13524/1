cat << 'EOF' > LiPSCl.inp
&GLOBAL
  PROJECT LiPSCl_surf
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS

    &MGRID
      CUTOFF 350
      REL_CUTOFF 50
      NGRIDS 5
    &END MGRID

    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
      EXTRAPOLATION ASPC
    &END QS

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-06
      MAX_SCF 50
      ADDED_MOS 200          ! 配合 Smearing 必须加上的空轨道数量
      &SMEAR                 ! 修正：纯净版 SMEAR 开关
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 1578   ! 修正：等效于 QE degauss = 0.01 Ry
      &END SMEAR
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2            ! 等效于 QE 的 mixing_beta = 0.2
        NBROYDEN 8
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    ! 完美的表面偶极校正与静电场求解器
    &POISSON
      PERIODIC XY            ! 取消 Z 轴的周期性
      POISSON_SOLVER ANALYTIC ! 修正：解析求解器自带 2D 校正，无需手动加 DIPOLE
    &END POISSON
  &END DFT

  &SUBSYS
    &CELL
      A 14.537405 0.000000 0.000000
      B  0.000000 20.558996 0.000000
      C  0.000000 0.000000 43.612217
      PERIODIC XY            ! 晶胞的周期性边界条件匹配求解器
    &END CELL

    &COORD
      SCALED T               ! 修正：使用标准的 Fortran 逻辑值 T
      Li 0.125000 0.488443 0.291667
